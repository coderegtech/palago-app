# Metro resolves modules by walking node_modules directories from the importing
# file upward, and does not follow pnpm's nested symlink layout. NativeWind's
# Babel transform rewrites JSX to import `react-native-css-interop/jsx-runtime`
# from inside *our* source files, so that package has to be visible at the root
# of node_modules even though it is only a transitive dependency of nativewind.
public-hoist-pattern[]=*react-native-css-interop*
