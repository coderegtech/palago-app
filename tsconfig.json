{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Do not set "jsx" here. expo/tsconfig.base sets "react-jsx" (the automatic
    // runtime), which SDK 57 and NativeWind's jsxImportSource both require.
    // Overriding it with "react" makes every .tsx file demand React in scope.
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    // Edge Functions are Deno, not React Native: they use jsr: specifiers,
    // .ts import extensions and the Deno global, none of which are valid in
    // this project. They are type-checked by the Supabase CLI / `deno check`.
    "supabase/functions"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
