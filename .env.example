# PalaGo environment configuration.
#
# Copy to `.env` and fill in. `.env` is git-ignored — never commit real values.
#
# Only EXPO_PUBLIC_* variables are readable by the app, and everything prefixed
# that way is INLINED INTO THE APP BUNDLE. Treat every value here as public.
# Service-role keys and QR signing secrets belong in Supabase Edge Function
# secrets (`supabase secrets set`), never in this file.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Local stack (default). Run `pnpm db:start`, then `pnpm exec supabase status`
# and copy its PUBLISHABLE_KEY (the `sb_publishable_…` value, not the legacy
# ANON_KEY JWT). Never copy SECRET_KEY or SERVICE_ROLE_KEY into this file — every
# EXPO_PUBLIC_* value is inlined into the shipped app bundle.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hosted project — swap the two values above for these when you move off local:
#   EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>
#
# Testing on a physical device against the local stack? 127.0.0.1 points at the
# phone itself. Use your machine's LAN address instead, e.g.
#   EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.100:54321

# ---------------------------------------------------------------------------
# Payments — MOCK ONLY
# ---------------------------------------------------------------------------
# `mock` is the only accepted value. PalaGo does not connect to Stripe, GCash,
# Maya, or any bank, and no real money is ever charged. See docs/payment-flow.md.
EXPO_PUBLIC_PAYMENT_PROVIDER=mock

# Base URL the payment QR points at, and the redirect base for password
# recovery. Must be reachable from the phone that scans it, so use your
# machine's LAN address rather than localhost when testing on a real device.
#
# On a deployed web build this is the deployed origin, e.g.
#   EXPO_PUBLIC_WEB_PAYMENT_BASE_URL=https://palago.vercel.app
# and that origin must also be added to Supabase > Authentication > URL
# Configuration, or password reset links are refused. See docs/deployment.md.
EXPO_PUBLIC_WEB_PAYMENT_BASE_URL=http://127.0.0.1:8090

# ---------------------------------------------------------------------------
# Maps (MapLibre)
# ---------------------------------------------------------------------------
# MapLibre style JSON. OpenFreeMap is the default and needs no API key.
# For production, consider MapTiler or a self-hosted style:
#   https://api.maptiler.com/maps/streets-v2/style.json?key=<key>
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ---------------------------------------------------------------------------
# Supabase CLI — config.toml substitution
# ---------------------------------------------------------------------------
# Read by `supabase/config.toml` via env(), for both the local stack and
# `supabase config push`. NOT an EXPO_PUBLIC_* value and never reaches the app
# bundle — the CLI reads it straight from this file.
#
# The base URL auth is allowed to redirect to and builds email links from. Set it
# to whatever this environment actually is: the deployed origin for a hosted
# project, and the same is fine locally because the localhost entries in
# `additional_redirect_urls` are always present.
SUPABASE_AUTH_SITE_URL=http://127.0.0.1:8090
