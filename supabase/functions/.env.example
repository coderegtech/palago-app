# Edge Function environment.
#
# Unlike the app's EXPO_PUBLIC_* values, these are server-side and are NOT
# shipped to clients. Set them locally in supabase/functions/.env, and in
# production with:
#
#   supabase secrets set PAYMENT_PROVIDER=mock WEB_PAYMENT_BASE_URL=https://...

# Only `mock` is implemented. Any other value makes the payment functions fail
# closed rather than silently behave as if a provider were wired.
PAYMENT_PROVIDER=mock

# Base URL the payment QR points at. Must be reachable from the phone that
# scans it — use your machine's LAN address when testing on a real device,
# not localhost.
WEB_PAYMENT_BASE_URL=http://127.0.0.1:8090

# HMAC secret for boarding-pass tokens. At least 32 characters — the functions
# fail closed if it is missing or too short, rather than issuing forgeable
# tokens that look fine. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SIGNING_SECRET=replace-with-64-hex-characters
